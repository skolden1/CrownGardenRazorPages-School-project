@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="hero-section">
    <div class="login-container">
        <form id="account" method="post">
            <div class="text-center mb-3">
                <img class="logo" src="~/Images/CrownGardenLogga.png" alt="Logo" style="width:100px; height:100px;" />
            </div>
            <h2 class="text-center mb-3" style="color:white;">Log In</h2>
            <hr />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="custom-floating-group mb-4">
                <div class="input-group position-relative">
                    <input asp-for="Input.Email" class="form-control" id="emailInput"  required />
                    <label asp-for="Input.Email" class="floating-label">E-postadress</label>
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <!--Added (view password function in (login) -->
            <div class="custom-floating-group mb-3">
                <div class="input-group">
                    <input asp-for="Input.Password" class="form-control" id="passwordInput" autocomplete="current-password"  />
                     <label asp-for="Input.Password">Password</label>
                    <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('passwordInput', 'toggleIcon1')" tabindex="-1">
                        <i class="bi bi-eye-slash" id="toggleIcon1"></i>
                       
                    </button>
                </div>
              
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-action-row d-flex justify-content-between align-items-center mb-4">
                <div class="form-check mb-0">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe" style="color:white;">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-lg" style="background:#0b3d1f; color:white; width:40%; ">
                    Log in
                </button>
            </div>

            <div class="login-links mt-3 text-center">
                <p><a asp-page="./ForgotPassword">Forgot your password?</a></p>
                <p><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a></p>
                <p><a asp-page="./ResendEmailConfirmation">Resend email confirmation</a></p>
            </div>
        </form>
    </div>
</div>

<style>
    .hero-section {
        background-image: url('@Url.Content("~/Images/CrownGardenHills-Hero3.jpg")');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-container {
        background-color: rgba(34, 34, 34, 0.95);
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 8px 16px rgba(0,0,0,0.2);
        width: 100%;
        max-width: 400px;
    }

    .custom-floating-group {
        position: relative;
        margin-bottom: 1.5rem;
    }

        .custom-floating-group .input-group,
        .custom-floating-group input {
            width: 100%;
        }

        .custom-floating-group input {
            padding: 1rem 0.75rem 0.25rem 0.75rem;
            background: #222;
            border: 1px solid #555;
            border-radius: 5px;
            color: #fff;
            font-size: 1rem;
            outline: none;
        }

            .custom-floating-group input:focus {
                background: #222 !important;
                color: #fff !important;
            }

        .custom-floating-group label {
            position: absolute;
            top: 1rem;
            left: 0.75rem;
            color: #aaa;
            background: #222;
            padding: 0 0.25rem;
            transition: 0.2s ease;
            pointer-events: none;
            z-index: 1;
        }

        .custom-floating-group input:focus + label,
        .custom-floating-group input:not(:placeholder-shown) + label {
            top: -0.5rem;
            left: 0.6rem;
            font-size: 0.75rem;
            color: #fff;
        }

    /* Autofill fix */
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px #222 inset !important;
        -webkit-text-fill-color: white !important;
        background-color: #222 !important;
        color: #fff !important;
    }

    .form-action-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .login-links a {
        color: white;
        text-decoration: none;
    }

    .input-group .btn {
        z-index: 2;
    }

   
    
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />



    <!-- Fixed the function (not show password as default -->
    <script>
        function togglePassword(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                icon.classList.add("bi-eye");
                icon.classList.remove("bi-eye-slash");
            } else {
                passwordInput.type = "password";
                icon.classList.add("bi-eye-slash");
                icon.classList.remove("bi-eye");
            }
        }
    </script>
}

