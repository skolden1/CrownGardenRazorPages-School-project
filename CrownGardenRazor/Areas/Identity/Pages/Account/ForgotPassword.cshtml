@page
@model ForgotPasswordModel
@{
    Layout = "/Pages/Shared/_IdentityLayout.cshtml";
    ViewData["Title"] = "Glömt lösenord?";
}

<div class="hero-section">
    <div class="login-container">
        <form method="post">
            <h2 class="text-center mb-3" style="color:white;">Återställ lösenord</h2>
            <hr />

            <div class="input-group mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="namn@exempel.se" required />
                <button type="submit" class="btn btn-lg" style="background:#0b3d1f; color:white; width:25%;">Skicka länk</button>
            </div>

            <span asp-validation-for="Input.Email" class="text-danger"></span>

            <div class="login-links mt-4 text-center">
                <p><a asp-page="./Login">Tillbaka till inloggning</a></p>
            </div>
        </form>
    </div>
</div>

<style>
    .input-group {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin-bottom: 1.5rem
    }

   
        .input-group input {
            width: 60%;
            padding: 1rem 0.75rem 0.25rem 0.75rem;
            background: #222;
            border: 1px solid #555;
            border-radius: 5px;
            color: #fff;
            font-size: 1rem;
            outline: none;
        }
        .btn {

        border: 1px solid #555;
        border-radius: 5px;
        color: #fff;
        font-size: 1rem;
          
        }
</style>