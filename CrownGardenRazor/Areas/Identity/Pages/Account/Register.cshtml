@page
@model RegisterModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Register";
}

<!-- Hero Section -->
<div class="hero-section text-center" style="background-image: url('/Images/CrownGardenHills-Hero3.jpg'); color: #fff; padding: 200px 20px;">
    <h1>Membership</h1>
    <h3>AN ICONIC GOLFING EXPERIENCE</h3>

</div>


<div class="container-fluid golf-resort-bg">
    <div class="row justify-content-start align-items-center" style="min-height: 100vh;">
        <div class="col-md-12 text-center mb-5 mt-5">
            <h3>Why Choose CrownGarden Resort?</h3>
            <p>
                Nestled in a stunning natural landscape, CrownGarden Resort is more than a golf destination—it’s a retreat for those seeking exceptional leisure and refined experiences.
                From the first drive to the final putt, each hole offers breathtaking views and carefully crafted challenges. With our warm hospitality and world-class amenities,
                you’ll feel at home whether you’re chasing a personal best or simply enjoying the scenic beauty
            </p>
        </div>
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header text-center" style="background: linear-gradient(45deg, #0b3d1f, #103c1f); color: #fff;">

                    <h3>Join Now exclusive club</h3>
                </div>
                <div class="card-body">
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="Input.FirstName" class="form-label">First Name</label>
                            <input asp-for="Input.FirstName" class="form-control" placeholder="Enter your first name" />
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.LastName" class="form-label">Last Name</label>
                            <input asp-for="Input.LastName" class="form-control" placeholder="Enter your last name" />
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.MembershipLevel" class="form-label">Membership Level</label>
                            <select asp-for="Input.MembershipLevel" class="form-select">
                                <option value="">Select Membership</option>
                                <option value="Gold">Gold</option>
                                <option value="Silver">Silver</option>
                                <option value="Bronze">Bronze</option>
                            </select>
                            <span asp-validation-for="Input.MembershipLevel" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <!--Added (view password function aven in (confirmPassword) field -->

                        <div class="mb-3">
                            <div class="input-group">
                                <input asp-for="Input.Password" class="form-control" id="passwordInput" autocomplete="current-password" placeholder="password" />
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('passwordInput', 'toggleIcon1')" tabindex="-1">
                                    <i class="bi bi-eye-slash" id="toggleIcon1"></i>
                                </button>
                            </div>
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>


                        <div class="form-floating mb-3">
                            <div class="input-group">
                                <input asp-for="Input.ConfirmPassword" class="form-control" id="confirmPasswordInput" autocomplete="new-password" placeholder="Re-enter your password" />
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('confirmPasswordInput', 'toggleIcon2')" tabindex="-1">
                                    <i class="bi bi-eye-slash" id="toggleIcon2"></i>
                                </button>
                            </div>

                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- Changed profile picture layout -->
                        <div class="mb-3">
                            <label for="profilePicture" class="form-label">Profile Picture</label>

                            <div class="border rounded shadow-sm p-2" style="height: 200px; display: flex; align-items: center; justify-content: center; background-color: #f8f9fa;">
                                <img id="profilePreview"
                                     src="/ProfilePictures/DefaultProfileImage.png"
                                     alt="Profile Preview"
                                     style="max-height: 100%; max-width: 100%; object-fit: cover;" />
                            </div>

                            <input type="file" class="form-control mt-2" id="profilePicture" name="ProfilePicture" accept="image/*" onchange="previewProfileImage(event)" />
                        </div>



                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>


                    </form>
                </div>
                <div class="card-footer text-center">
                    <small>By clicking Sign Up, you agree to our <a href="#">Terms of Service</a>, <a href="#">Data Policy</a>, and <a href="#">Cookie Policy</a></small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background-image: url('@Url.Content("~/Images/CrownGardenHills-Hero3.jpg")');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-container {
        background-color: rgba(34, 34, 34, 0.95);
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 8px 16px rgba(0,0,0,0.2);
        width: 100%;
        max-width: 400px;
    }

    .custom-floating-group {
        position: relative;
        margin-bottom: 1.5rem;
    }

        .custom-floating-group input {
            width: 100%;
            padding: 1rem 0.75rem 0.25rem 0.75rem;
            background: #222;
            border: 1px solid #555;
            border-radius: 5px;
            color: #fff;
            font-size: 1rem;
            outline: none;
        }

        .custom-floating-group label {
            position: absolute;
            top: 1rem;
            left: 0.75rem;
            color: #aaa;
            background: #222;
            padding: 0 0.25rem;
            transition: 0.2s ease;
            pointer-events: none;
        }

    .form-action-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .custom-floating-group input:focus + label,
    .custom-floating-group input:not(:placeholder-shown) + label {
        top: -0.5rem;
        left: 0.6rem;
        font-size: 0.75rem;
        color: #fff;
    }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px #222 inset !important;
        -webkit-text-fill-color: white !important;
    }

    .login-links a {
        color: white;
        text-decoration: none;
    }

    media (max-width: 576px) {
        .login-container

    {
        padding: 20px;
    }

    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />


    <!-- Fixed the function (not show password as default -->
    <script>
        function togglePassword(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                icon.classList.add("bi-eye");
                icon.classList.remove("bi-eye-slash");
            } else {
                passwordInput.type = "password";
                icon.classList.add("bi-eye-slash");
                icon.classList.remove("bi-eye");
            }
        }
    </script>

    <!-- Added script for the profile picture in (register)-->
    <script>
        function previewProfileImage(event) {
            const preview = document.getElementById('profilePreview');
            const file = event.target.files[0];

            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                };
                reader.readAsDataURL(file);
            } else {
                preview.src = '/ProfilePictures/DefaultProfileImage.png';
            }
        }
    </script>
}
