@page
@model RegisterModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Registrera";
}

<!-- Hero Section -->
<div class="hero-section text-center" style="background-image: url('/Images/CrownGardenHills-Hero3.jpg'); color: #fff;">
    <h1>Medlemskap</h1>
    <h3>EN IKONISK GOLFUPPLEVELSE</h3>
</div>

<div class="container-fluid golf-resort-bg">
    <div class="row justify-content-start align-items-center" style="min-height: 100vh;">
        <div class="col-md-12 text-center mb-5 mt-5">
            <h3>Varför välja CrownGarden Resort?</h3>
            <p>
                Omgiven av ett fantastiskt naturlandskap är CrownGarden Resort mer än bara en golfdestination – det är en fristad för dig som söker exklusiv avkoppling och förstklassiga upplevelser.
                Från första utslaget till sista putten bjuder varje hål på hisnande vyer och noggrant utformade utmaningar. Med vår varma gästfrihet och världsklassiga faciliteter kommer du känna dig som hemma,
                oavsett om du jagar personbästa eller bara njuter av den vackra naturen.
            </p>
        </div>
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header text-center" style="background: linear-gradient(45deg, #0b3d1f, #103c1f); color: #fff;">
                    <h3>Bli medlem i vår exklusiva klubb</h3>
                </div>
                <div class="card-body">
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="Input.FirstName" class="form-label">Förnamn</label>
                            <input asp-for="Input.FirstName" class="form-control" placeholder="Ange ditt förnamn" />
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.LastName" class="form-label">Efternamn</label>
                            <input asp-for="Input.LastName" class="form-control" placeholder="Ange ditt efternamn" />
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label for="profileImage" class="form-label">Profilbild</label>
                            <div class="border rounded shadow-sm p-2" style="height: 200px; display: flex; align-items: center; justify-content: center; background-color: #f8f9fa;">
                                <img id="profilePreview"
                                     src="/ProfilePictures/DefaultProfileImage.png"
                                     alt="Profile Preview"
                                     style="max-height: 100%; max-width: 100%; object-fit: cover;" />
                            </div>
                            <input type="file" class="form-control mt-2" id="profilePicture" name="ProfileImage" onchange="previewProfileImage(event)" accept=".jpg,.jpeg,.png" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.MembershipLevel" class="form-label">Medlemsnivå</label>
                            <select asp-for="Input.MembershipLevel" class="form-select">
                                <option value="">Välj medlemskap</option>
                                <option value="Gold">Guld</option>
                                <option value="Silver">Silver</option>
                                <option value="Bronze">Brons</option>
                            </select>
                            <span asp-validation-for="Input.MembershipLevel" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">E-postadress</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="namn@exempel.se" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Lösenord</label>
                            <div class="input-group">
                                <input asp-for="Input.Password" class="form-control" id="passwordInput" placeholder="Ange ditt lösenord" />
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()" tabindex="-1">
                                    <i class="bi bi-eye" id="toggleIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Bekräfta lösenord</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Ange lösenordet igen" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg" style="background:#0b3d1f; color:white">Registrera</button>
                    </form>
                </div>
                <div class="card-footer text-center">
                    <small>Genom att klicka på Registrera godkänner du våra <a href="#">Användarvillkor</a>, <a href="#">Datapolicy</a> och <a href="#">Cookiepolicy</a>.</small>
                </div>
            </div>
        </div>
    </div>
</div>


<style>
    .hero-section {
        background-image: url('@Url.Content("~/Images/CrownGardenHills-Hero3.jpg")');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }

    .login-container {
        background-color: rgba(34, 34, 34, 0.95);
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 8px 16px rgba(0,0,0,0.2);
        width: 100%;
        max-width: 400px;
    }

    .custom-floating-group {
        position: relative;
        margin-bottom: 1.5rem;
    }

        .custom-floating-group input {
            width: 100%;
            padding: 1rem 0.75rem 0.25rem 0.75rem;
            background: #222;
            border: 1px solid #555;
            border-radius: 5px;
            color: #fff;
            font-size: 1rem;
            outline: none;
        }

        .custom-floating-group label {
            position: absolute;
            top: 1rem;
            left: 0.75rem;
            color: #aaa;
            background: #222;
            padding: 0 0.25rem;
            transition: 0.2s ease;
            pointer-events: none;
        }

    .form-action-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .custom-floating-group input:focus + label,
    .custom-floating-group input:not(:placeholder-shown) + label {
        top: -0.5rem;
        left: 0.6rem;
        font-size: 0.75rem;
        color: #fff;
    }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px #222 inset !important;
        -webkit-text-fill-color: white !important;
    }

    .login-links a {
        color: white;
        text-decoration: none;
    }

    media (max-width: 576px) {
        .login-container

    {
        padding: 20px;
    }

    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />



    <script>
        function togglePassword() {
            const passwordInput = document.getElementById("passwordInput");
            const toggleIcon = document.getElementById("toggleIcon");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                toggleIcon.classList.remove("bi-eye");
                toggleIcon.classList.add("bi-eye-slash");
            } else {
                passwordInput.type = "password";
                toggleIcon.classList.remove("bi-eye-slash");
                toggleIcon.classList.add("bi-eye");
            }
        }

         function previewProfileImage(event) {
            const preview = document.getElementById('profilePreview');
            const file = event.target.files[0];

            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                };
                reader.readAsDataURL(file);
            } else {
                preview.src = '/ProfilePictures/DefaultProfileImage.png';
            }
        }
    </script>

}