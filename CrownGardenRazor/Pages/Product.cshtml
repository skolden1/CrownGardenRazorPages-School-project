@page
@model CrownGardenRazor.Pages.ProductModel
@{
    ViewData["Title"] = "Vår shop";
}
<head>
    <link rel="stylesheet" href="~/css/Product.css" asp-append-version="true" />
    <title>
        @ViewData["Title"];
    </title>
</head>

<div class="mb-3">
    <img src="~/images/produktshopbanner.png" alt="Golfbild" class="img-fluid" />
</div>

<form method="get">
    <div class="mb-4">
        <div class="input-group mb-3">
            <input type="text" class="form-control" placeholder="Search" aria-label="Search" name="SearchWord">
            <button class="btn btn-success" type="submit">Sök och filtrera</button>
        </div>
    </div>

    <div class="container mt-4">
        <div class="row">
            <aside class="col-md-3">
                <div class="p-4 border rounded shadow-sm bg-light">
                    <h5 class="mb-3">Filtrera efter pris</h5>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Under300" value="true">
                        <label class="form-check-label">Under 300kr</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Over300Under800" value="true">
                        <label class="form-check-label">300kr - 800kr</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Over800Under2500" value="true">
                        <label class="form-check-label">800kr - 2500kr</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Over2500" value="true">
                        <label class="form-check-label">Över 2500kr</label>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</form>

<div class="container mt-2">

    <div class="row">
        <main class="col-md-9 offset-md-3">
            @if (Model.ErrorMessage != null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage

                    <a href="/Identity/Account/Login">Logga in här</a>
                </div>

            }

            @if (TempData["AddToCartMsg"] != null)
            {
                <div class="alert alert-success">@TempData["AddToCartMsg"]</div>
            }

            @if (Model.productList != null && Model.productList.Any())
            {
                <div class="row">
                    @foreach (var product in Model.productList)
                    {
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="product-item border p-3 d-flex flex-column bg-white p-3">
                                <a asp-page="ProductDetails" asp-route-id="@product.ProductId">
                                    <img src="~/images/@product.ImageUrl" alt="@product.ProductName" class="product-image img-fluid" />
                                </a>
                                <a asp-page="ProductDetails" asp-route-id="@product.ProductId">
                                    <h6>@product.ProductName</h6>
                                </a>
                                <p>Pris: @product.Price.ToString("C")</p>
                                <p>Antal i lager: @product.Quantity</p>
                         
                                <form method="post" asp-page-handler="AddToCart">
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <button type="submit" class="btn btn-success btn-md">Lägg i kundvagn</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="alert alert-warning">@Model.ErrorMessage</p>
            } 
        </main>
    </div>
</div>