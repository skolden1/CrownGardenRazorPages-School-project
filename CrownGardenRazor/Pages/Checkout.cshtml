@page
@model CrownGardenRazor.Pages.CheckoutModel
@{
    ViewData["Title"] = "Kassa";
}

<h3>Din varukorg</h3>

@if (Model.ErrorMsg != null && Model.ErrorMsg != "")
{
    <div class="alert alert-danger">
        @Model.ErrorMsg
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h4>Varukorg</h4>
        </div>
        <div class="card-body">
            <ul class="list-group">

                @foreach (var p in Model.CartItemList)
                {
                    <li class="list-group-item">
                        <div class="row">
                            <div class="col-12 col-md-4">
                                <strong>@p.Product.ProductName</strong>                          
                            </div>
                            <div class="col-12 col-md-2 text-center mt-2 mt-md-0">
                               
                                <div class="d-flex gap-2 justify-content-center align-content-center">
                                    <form method="post" asp-page-handler="IncreaseQuantity">
                                        <input type="hidden" name="productId" value="@p.ProductId" />
                                        <button type="submit" class="btn btn-light rounded-circle fw-bold text-black border-0 d-flex justify-content-center align-items-center"
                                                style="width: 40px; height: 40px; font-size: 1.5rem;">+</button>
                                    </form>

                                    <p class="mb-0 align-self-center"><strong>x @p.Quantity</strong> </p>

                                    <form method="post" asp-page-handler="Delete">
                                        <input type="hidden" name="cartItemId" value="@p.CartId" />
                                        <button type="submit" class="btn btn-light rounded-circle fw-bold text-black border-0 d-flex justify-content-center align-items-center"
                                                style="width: 40px; height: 40px; font-size: 1.5rem;">
                                    -
                                </button>
                                    </form>
                                </div>
                            </div>

                            <div class="col-12 col-md-3 text-center mt-2 mt-md-0">
                                <span>@p.Product.Price.ToString("C") /st</span>
                            </div>

                            <div class="col-12 col-md-3 text-center mt-2 mt-md-0">
                                <span><strong>Totalpris:</strong></span>
                                <p class="d-inline-block">
                                    @((p.Quantity * p.Product.Price).ToString("C"))
                                </p>
                                                   
                            </div>
                        </div>             
                    </li>                 
                }
            </ul>
        </div>

        <div class="card-footer mt-3">
            <div class="row">
                <div class="col-md-6">
                    <h5>Total: @Model.TotalAmounT.ToString("C")</h5>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3 align-items-baseline">
                <form method="post" asp-page-handler="CheckoutOrder">
                
                    <div class="d-flex mt-3 gap-2">
                        <button type="submit" class="btn btn-success">Köp</button>
                    </div>                          
                </form>
                <a asp-page="Product">
                    <button class="btn btn-primary mb-1">Tillbaka till produkter</button>
                </a>
            </div>

        </div>
    </div>
}




