<link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css" rel="stylesheet">
<div class="container">
    <div class="row">
        <div class="col-md-8">

            @foreach (Model.PostModel item in Model.Posts)
            {
                <div class="post-content">
                    <img src="@item.PostPic" alt="post-image" class="img-responsive post-image">
                    <div class="post-container">
                        <img src="@item.ProfileLink" alt="user" class="profile-photo-md pull-left">
                        <div class="post-detail">
                            <div class="user-info">
                                <h5><a href="timeline.html" class="profile-link">@Model.GetEmailForPost(item.UserId)</a> <span class="following">following</span></h5>
                                <p class="text-muted">Published a photo on @item.PostDate.ToString()</p>
                            </div>
                            <div class="reaction">
                                <a class="btn text-green"><i class="fa fa-thumbs-up"></i>@item.LikeQuantity</a>
                                @*          <a class="btn text-red"><i class="fa fa-thumbs-down"></i> 0</a> *@
                            </div>
                            <div class="line-divider"></div>
                            <div class="post-text">
                                <p><i class="em em-anguished">@item.PostTxt</i> <i class="em em-anguished"></i> <i class="em em-anguished"></i></p>
                            </div>
                            <div class="line-divider"></div>
                            @foreach (string comment in Model.GetCommentsForPost(item))
                            {
                                <div class="post-comment">
                                    <img src="https://bootdey.com/img/Content/avatar/avatar7.png" alt="" class="profile-photo-sm">
                                    <p><a href="timeline.html" class="profile-link">@GetEmailForPost()</a><i class="em em-laughing"></i>@comment</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>